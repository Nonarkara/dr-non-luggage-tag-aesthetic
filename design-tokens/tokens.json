{
  "$comment": "Dr Non’s Luggage Tag Aesthetic. SPDX-License-Identifier: MIT. Size and domain are information. Domain colours are extensions.",
  "tag": {
    "color": {
      "ground": { "$value": "#f7f6f2", "$type": "color", "$description": "Thermal face stock. Near-white, slightly warm." },
      "ground-strict": { "$value": "#fffefa", "$type": "color", "$description": "Inner tag paper." },
      "ink": { "$value": "#111111", "$type": "color", "$description": "Direct-thermal ink analogue. Near-black." },
      "ink-soft": { "$value": "#2a2a2a", "$type": "color", "$description": "Still-legible secondary ink. Not muted grey decoration." },
      "rule": { "$value": "#111111", "$type": "color" },
      "domain": {
        "$description": "Optional. Only when the closed package includes that domain.",
        "priority": { "$value": "#7a3e00", "$type": "color", "$description": "Expedite / rush / SLA. Lead digit 2 analogue." },
        "crew": { "$value": "#0b3d7a", "$type": "color", "$description": "Crew / staff bag domain." },
        "hazard": { "$value": "#8b1212", "$type": "color", "$description": "Hazard / DG / blocking alert." }
      }
    },
    "font": {
      "dest": { "$value": "Arial Narrow, Helvetica Neue Condensed, Franklin Gothic Medium, Arial, sans-serif", "$type": "fontFamily", "$description": "Primary destination. Condensed so three letters dominate." },
      "body": { "$value": "Arial, Helvetica, sans-serif", "$type": "fontFamily" },
      "mono": { "$value": "ui-monospace, Cascadia Mono, SF Mono, Courier New, monospace", "$type": "fontFamily", "$description": "LPN, flight, timestamps. Machine-key domain." }
    },
    "rank": {
      "primary": {
        "fontSize": { "$value": "clamp(3.25rem, 14vw, 7.5rem)", "$type": "fontSize" },
        "fontWeight": { "$value": 800, "$type": "fontWeight" },
        "letterSpacing": { "$value": "-0.06em", "$type": "dimension" },
        "lineHeight": { "$value": 0.82, "$type": "number" },
        "domain": "IATA three-letter destination (or the package’s destination-equivalent)"
      },
      "secondary": {
        "fontSize": { "$value": "1.125rem", "$type": "fontSize" },
        "fontWeight": { "$value": 500, "$type": "fontWeight" },
        "letterSpacing": { "$value": "0.18em", "$type": "dimension" },
        "fontFamily": "mono",
        "domain": "10-digit LPN / stable object id + barcode"
      },
      "tertiary": {
        "fontSize": { "$value": "0.8125rem", "$type": "fontSize" },
        "fontWeight": { "$value": 500, "$type": "fontWeight" },
        "letterSpacing": { "$value": "0.06em", "$type": "dimension" },
        "domain": "carrier, flight, date, owner, environment"
      },
      "fallback": {
        "fontSize": { "$value": "0.75rem", "$type": "fontSize" },
        "fontWeight": { "$value": 700, "$type": "fontWeight" },
        "letterSpacing": { "$value": "0.14em", "$type": "dimension" },
        "domain": "passenger name / human subject if machines fail"
      }
    },
    "space": {
      "1": { "$value": "0.25rem", "$type": "dimension" },
      "2": { "$value": "0.5rem", "$type": "dimension" },
      "3": { "$value": "0.75rem", "$type": "dimension" },
      "4": { "$value": "1rem", "$type": "dimension" },
      "5": { "$value": "1.5rem", "$type": "dimension" },
      "6": { "$value": "2rem", "$type": "dimension" },
      "7": { "$value": "3rem", "$type": "dimension" },
      "8": { "$value": "4rem", "$type": "dimension" }
    },
    "barcode": {
      "module": { "$value": "0.125rem", "$type": "dimension" },
      "height": { "$value": "4.5rem", "$type": "dimension" },
      "symbology": "Code 128 (IATA Resolution 740 LPN). Dual print at 90° on physical tags."
    }
  }
}
